SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,portfolio-backend-hpcb.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production hosts often provide DATABASE_URL, for example:
# DATABASE_URL=postgres://portfolio_user:password@host:5432/portfolio_db
DATABASE_URL=
DB_SSL_REQUIRE=False

# Local PostgreSQL is enabled when DB_NAME is set and DATABASE_URL is empty.
DB_NAME=portfolio_db
DB_USER=portfolio_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Production security toggles. Turn these on after your HTTPS domain works.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
